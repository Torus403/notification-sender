{
	"name": "@notification-sender/node",
	"version": "0.0.0",
	"private": true,
	"description": "Server SDK for the NotificationSender API.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"typecheck": "tsc",
		"test": "node --test --experimental-strip-types test/*.test.ts"
	},
	"devDependencies": {
		"@notification-sender/config": "workspace:*",
		"@types/node": "^22.10.2",
		"typescript": "~6.0.3"
	}
}
